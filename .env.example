# Copy this file to ".env" (same folder) and fill in ONE provider.
# Paste keys directly after "=" - no quotes, no spaces. Never commit .env.

# LLM provider: groq | gemini | none (none = offline rule-based mode)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Retrieval: USE_EMBEDDINGS=0 means TF-IDF only (faster start, no model download)
USE_EMBEDDINGS=1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5

# OCR for scanned PDFs (needs tesseract installed)
ENABLE_OCR=1
