    # Copy to .env and fill in ONE provider. Never commit .env.
    LLM_PROVIDER=groq            # groq | gemini | none
    GROQ_API_KEY=
    GROQ_MODEL=llama-3.3-70b-versatile
    GEMINI_API_KEY=
    GEMINI_MODEL=gemini-2.5-flash

    # Retrieval
    USE_EMBEDDINGS=1             # 0 = TF-IDF only (faster start, no model download)
    EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
    TOP_K=5

    # OCR for scanned PDFs (needs tesseract installed)
    ENABLE_OCR=1
